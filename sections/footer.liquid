<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        {%- assign f_logo_h = section.settings.logo_height | default: 40 -%}
        {%- if section.settings.logo != blank -%}
          {%- assign f_logo_w = f_logo_h | times: section.settings.logo.aspect_ratio | round | at_least: 1 -%}
          {%- assign flw2 = f_logo_w | times: 2 -%}{%- assign flw3 = f_logo_w | times: 3 -%}
          <img src="{{ section.settings.logo | image_url: width: flw2 }}" srcset="{{ section.settings.logo | image_url: width: flw2 }} 2x, {{ section.settings.logo | image_url: width: flw3 }} 3x" alt="{{ shop.name }}" width="{{ f_logo_w }}" height="{{ f_logo_h }}" style="height:{{ f_logo_h }}px;width:auto">
        {%- else -%}
          {%- assign f_logo_w = f_logo_h | times: 3.385 | round -%}
          <img src="{{ 'logo-rev.png' | asset_url }}" alt="{{ shop.name }}" width="{{ f_logo_w }}" height="{{ f_logo_h }}" style="height:{{ f_logo_h }}px;width:auto">
        {%- endif -%}
        <p>{{ section.settings.tagline }}</p>
      </div>

      {%- for i in (1..4) -%}
        {%- assign hkey = 'heading_' | append: i -%}
        {%- assign mkey = 'menu_' | append: i -%}
        {%- assign menu = section.settings[mkey] -%}
        {%- assign is_policy_col = false -%}
        {%- assign is_social_col = false -%}
        {%- if section.settings.policy_column == i and section.settings.show_policies -%}{%- assign is_policy_col = true -%}{%- endif -%}
        {%- if section.settings.social_column == i -%}{%- assign is_social_col = true -%}{%- endif -%}

        {%- if menu != blank or is_policy_col or is_social_col -%}
        <div class="footer__col">
          <h4>{{ section.settings[hkey] }}</h4>

          {%- if menu != blank -%}
            {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
          {%- endif -%}

          {%- comment -%} Store policies pull straight from Settings > Policies, so they
          only appear once they exist and always point at the right URL. {%- endcomment -%}
          {%- if is_policy_col -%}
            {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}
            {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
            {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
            {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
            {%- if shop.subscription_policy != blank -%}<a href="{{ shop.subscription_policy.url }}">{{ shop.subscription_policy.title }}</a>{%- endif -%}
          {%- endif -%}

          {%- if is_social_col -%}
            {%- if section.settings.instagram != blank -%}
              <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a>
            {%- endif -%}
            {%- assign footer_email = section.settings.email | default: settings.contact_email -%}
            {%- if footer_email != blank -%}
              <a href="mailto:{{ footer_email }}">{{ footer_email }}</a>
            {%- endif -%}
          {%- endif -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All artwork officially licensed.</span>
      {%- comment -%} Shown when the store sells to more than one market (UK in GBP, US in USD),
      as on the current site. Prices across the site switch to the chosen currency. {%- endcomment -%}
      {%- if localization.available_countries.size > 1 -%}
        {%- form 'localization', id: 'footer-localization', class: 'footer__locale' -%}
          <label for="footer-country" class="visually-hidden">Country / region</label>
          <select id="footer-country" name="country_code" onchange="this.form.submit()">
            {%- for c in localization.available_countries -%}
              <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit">Update</button></noscript>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Footer logo (white on transparent)", "info": "PNG or SVG. Leave empty to use the built-in signature." },
    { "type": "range", "id": "logo_height", "label": "Footer logo height", "min": 20, "max": 110, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Brand" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "London-based screen printing artist. Officially licensed Pan Am, TWA and Braniff artwork, printed onto archival fine art paper in limited editions of 25." },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "heading_1", "label": "Column 1 heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_1", "label": "Column 1 menu" },
    { "type": "text", "id": "heading_2", "label": "Column 2 heading", "default": "Studio" },
    { "type": "link_list", "id": "menu_2", "label": "Column 2 menu" },
    { "type": "text", "id": "heading_3", "label": "Column 3 heading", "default": "Help" },
    { "type": "link_list", "id": "menu_3", "label": "Column 3 menu" },
    { "type": "text", "id": "heading_4", "label": "Column 4 heading", "default": "Follow" },
    { "type": "link_list", "id": "menu_4", "label": "Column 4 menu" },
    { "type": "header", "content": "Store policies" },
    { "type": "paragraph", "content": "Shipping, refund, privacy and terms links are pulled automatically from Settings > Policies. Each one appears only once you have written it." },
    { "type": "checkbox", "id": "show_policies", "label": "Show store policy links", "default": true },
    { "type": "range", "id": "policy_column", "label": "Show policies in column", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Social" },
    { "type": "range", "id": "social_column", "label": "Show social links in column", "min": 1, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "instagram", "label": "Instagram URL", "default": "https://www.instagram.com/ella_freire" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "Instagram" },
    { "type": "text", "id": "email", "label": "Contact email", "info": "Leave empty to use the contact email in Theme settings > Brand." }
  ]
}
{% endschema %}
