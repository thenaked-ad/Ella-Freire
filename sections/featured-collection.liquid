{%- assign coll = collections[section.settings.collection] -%}
{%- if coll == blank -%}{%- assign coll = collections.all -%}{%- endif -%}
<section class="section">
  <div class="container">
    <div class="section__head reveal">
      <div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="h2">{{ section.settings.heading }}</h2></div>
      <a href="{{ coll.url }}" class="link">{{ section.settings.link_text }}</a>
    </div>
    <div class="grid">
      {%- for product in coll.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured editions",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Editions" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View all" }
  ]
}
{% endschema %}
