<section class="section bg-cream">
  <div class="container">
    <div class="artist">
      <div class="artist__media reveal">
        {%- if section.settings.image != blank -%}<img src="{{ section.settings.image | image_url: width: 1000 }}" alt="Ella Freire" width="1000" height="1250" loading="lazy">
        {%- else -%}<img src="{{ 'ella-portrait.jpg' | asset_url }}" alt="Ella Freire with her prints" width="912" height="1167" loading="lazy">{%- endif -%}
      </div>
      <div class="reveal d1">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="h2">{{ section.settings.heading }}</h2>
        <p class="artist__quote">&ldquo;{{ section.settings.quote }}&rdquo;</p>
        <p class="artist__sub">{{ section.settings.sub }}</p>
        <p class="artist__creds">{{ section.settings.creds }}</p>
        <a href="{{ section.settings.link | default: '/pages/about' }}" class="btn btn--outline">{{ section.settings.link_text }}</a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Artist strip",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Portrait" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Artist" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ella Freire" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "I have always had a bit of an obsession with all things tickets and luggage labels." },
    { "type": "text", "id": "sub", "label": "Sub line", "default": "London-based screen printing artist, Delta House Studios, Wimbledon. 14 years at the press." },
    { "type": "text", "id": "creds", "label": "Credentials", "default": "Royal Academy 2024 · Pan Am Museum, NY · Officially licensed" },
    { "type": "text", "id": "link_text", "label": "Button", "default": "Read her story" },
    { "type": "url", "id": "link", "label": "Button link" }
  ]
}
{% endschema %}
