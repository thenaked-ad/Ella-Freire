<section class="section--tight section bg-sec">
  <div class="newsletter reveal">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="h2">{{ section.settings.heading }}</h2>
    <p class="lede" style="margin-top:12px">{{ section.settings.text }}</p>
    {%- form 'customer', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required aria-label="Email">
      <button type="submit" class="btn btn--primary">{{ section.settings.button }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "First Access" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Boarding announcements" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New editions, exhibition dates, and the rare moments a sold-out destination returns to the studio." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "button", "label": "Button", "default": "Subscribe" }
  ]
}
{% endschema %}
