<section class="section bg-sec">
  <div class="container">
    <div class="section__head reveal"><div><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 class="h2">{{ section.settings.heading }}</h2></div></div>
    <div class="airlines">
      {%- for i in (1..3) -%}
        {%- assign ckey = 'collection_' | append: i -%}{%- assign ikey = 'image_' | append: i -%}{%- assign lkey = 'label_' | append: i -%}
        {%- assign c = collections[section.settings[ckey]] -%}
        {%- if c != blank -%}
        <a href="{{ c.url }}" class="airline reveal d{{ i }}">
          {%- if section.settings[ikey] != blank -%}<img src="{{ section.settings[ikey] | image_url: width: 1000 }}" alt="" width="1000" height="750" loading="lazy">
          {%- elsif c.image -%}<img src="{{ c.image | image_url: width: 1000 }}" alt="" width="1000" height="750" loading="lazy">
          {%- elsif c.products.first.featured_image -%}<img src="{{ c.products.first.featured_image | image_url: width: 1000 }}" alt="" width="1000" height="750" loading="lazy">
          {%- else -%}{%- assign fallbacks = 'lifestyle-lon-wide.jpg,lifestyle-nyc-wide.jpg,lifestyle-braniff-wide.jpg' | split: ',' -%}
          <img src="{{ fallbacks[forloop.index0] | default: 'lifestyle-lon-wide.jpg' | asset_url }}" alt="" width="1000" height="750" loading="lazy">{%- endif -%}
          <div class="airline__body"><span class="eyebrow light">{{ section.settings[lkey] }}</span><h3>{{ c.title }}</h3><span>{{ c.products_count }} destinations →</span></div>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Airline collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fly With" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three iconic airlines. One golden age." },
    { "type": "collection", "id": "collection_1", "label": "Collection 1" }, { "type": "text", "id": "label_1", "label": "Label 1", "default": "Est. 1927" }, { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "collection", "id": "collection_2", "label": "Collection 2" }, { "type": "text", "id": "label_2", "label": "Label 2", "default": "Est. 1930" }, { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "collection", "id": "collection_3", "label": "Collection 3" }, { "type": "text", "id": "label_3", "label": "Label 3", "default": "Est. 1928" }, { "type": "image_picker", "id": "image_3", "label": "Image 3" }
  ]
}
{% endschema %}
