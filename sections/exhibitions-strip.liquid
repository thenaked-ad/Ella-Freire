<section class="section bg-pan" style="position:relative;overflow:hidden">
  {% render 'globe-deco', size: 300, opacity: 0.08, color: '#fff', style: 'top:-12%;right:-4%' %}
  <div class="container" style="position:relative">
    <div class="section__head reveal"><div><span class="eyebrow light">{{ section.settings.eyebrow }}</span><h2 class="h2">{{ section.settings.heading }}</h2></div><a href="{{ section.settings.link | default: '/pages/exhibitions' }}" class="link light">All exhibitions →</a></div>
    {%- for i in (1..3) -%}
      {%- assign n = 'name_' | append: i -%}{%- assign l = 'loc_' | append: i -%}{%- assign d = 'date_' | append: i -%}{%- assign x = 'next_' | append: i -%}
      {%- if section.settings[n] != blank -%}
      <div class="fair reveal d{{ i }}">
        <div class="fair__l">{%- if section.settings[x] -%}<span class="badge-next">Next</span>{%- endif -%}<span class="fair__name">{{ section.settings[n] }}</span></div>
        <div class="fair__r"><span class="fair__loc">{{ section.settings[l] }}</span><span class="fair__date">{{ section.settings[d] }}</span></div>
      </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Exhibitions strip",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "See It In Person" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upcoming exhibitions" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "name_1", "label": "Fair 1", "default": "Affordable Art Fair Battersea Autumn" }, { "type": "text", "id": "loc_1", "label": "Location 1", "default": "London, UK" }, { "type": "text", "id": "date_1", "label": "Date 1", "default": "14-18 Oct 2026" }, { "type": "checkbox", "id": "next_1", "label": "Mark as next", "default": true },
    { "type": "text", "id": "name_2", "label": "Fair 2", "default": "The Other Art Fair Chicago" }, { "type": "text", "id": "loc_2", "label": "Location 2", "default": "Chicago, IL" }, { "type": "text", "id": "date_2", "label": "Date 2", "default": "12-15 Nov 2026" }, { "type": "checkbox", "id": "next_2", "label": "Mark as next", "default": false },
    { "type": "text", "id": "name_3", "label": "Fair 3", "default": "Affordable Art Fair Battersea Spring" }, { "type": "text", "id": "loc_3", "label": "Location 3", "default": "London, UK" }, { "type": "text", "id": "date_3", "label": "Date 3", "default": "4-8 Mar 2027" }, { "type": "checkbox", "id": "next_3", "label": "Mark as next", "default": false }
  ]
}
{% endschema %}
