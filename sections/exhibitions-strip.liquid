<section class="section bg-pan" style="position:relative;overflow:hidden">
  {% render 'globe-deco', size: 300, opacity: 0.08, color: '#fff', style: 'top:-12%;right:-4%' %}
  <div class="container" style="position:relative">
    <div class="flow reveal">
      <div class="flow__head"><span class="eyebrow light">{{ section.settings.eyebrow }}</span><h2 class="h2">{{ section.settings.heading }}</h2></div>
      <a href="{{ section.settings.link | default: '/pages/exhibitions' }}" class="link light flow__link">All exhibitions →</a>
      <div class="flow__body">
    {%- for i in (1..3) -%}
      {%- assign n = 'name_' | append: i -%}{%- assign l = 'loc_' | append: i -%}{%- assign d = 'date_' | append: i -%}{%- assign x = 'next_' | append: i -%}
      {%- if section.settings[n] != blank -%}
      {%- assign u = 'url_' | append: i -%}
      {%- assign fair_url = section.settings[u] -%}
      {%- comment -%} Rendered as a link only when the fair has one, so an
      un-linked fair stays a plain row rather than a dead anchor. {%- endcomment -%}
      {%- if fair_url != blank -%}
      {%- assign ext = false -%}{%- if fair_url contains '://' -%}{%- assign ext = true -%}{%- endif -%}
      <a class="fair fair--link reveal d{{ i }}" href="{{ fair_url }}"{% if ext %} target="_blank" rel="noopener"{% endif %}>
        <div class="fair__l">{%- if section.settings[x] -%}<span class="badge-next">Next</span>{%- endif -%}<span class="fair__name">{{ section.settings[n] }}</span></div>
        <div class="fair__r"><span class="fair__loc">{{ section.settings[l] }}</span><span class="fair__date">{{ section.settings[d] }}</span><span class="fair__go" aria-hidden="true">&rarr;</span></div>
      </a>
      {%- else -%}
      <div class="fair reveal d{{ i }}">
        <div class="fair__l">{%- if section.settings[x] -%}<span class="badge-next">Next</span>{%- endif -%}<span class="fair__name">{{ section.settings[n] }}</span></div>
        <div class="fair__r"><span class="fair__loc">{{ section.settings[l] }}</span><span class="fair__date">{{ section.settings[d] }}</span></div>
      </div>
      {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Exhibitions strip",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "See It In Person"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming exhibitions"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "name_1",
      "label": "Fair 1",
      "default": "Affordable Art Fair Battersea Autumn"
    },
    {
      "type": "text",
      "id": "loc_1",
      "label": "Location 1",
      "default": "London, UK"
    },
    {
      "type": "text",
      "id": "date_1",
      "label": "Date 1",
      "default": "14-18 Oct 2026"
    },
    {
      "type": "checkbox",
      "id": "next_1",
      "label": "Mark as next",
      "default": true
    },
    {
      "type": "url",
      "id": "url_1",
      "label": "Event link 1",
      "info": "Optional. Links the whole row to the fair's own page."
    },
    {
      "type": "text",
      "id": "name_2",
      "label": "Fair 2",
      "default": "The Other Art Fair Chicago"
    },
    {
      "type": "text",
      "id": "loc_2",
      "label": "Location 2",
      "default": "Chicago, IL"
    },
    {
      "type": "text",
      "id": "date_2",
      "label": "Date 2",
      "default": "12-15 Nov 2026"
    },
    {
      "type": "checkbox",
      "id": "next_2",
      "label": "Mark as next",
      "default": false
    },
    {
      "type": "url",
      "id": "url_2",
      "label": "Event link 2"
    },
    {
      "type": "text",
      "id": "name_3",
      "label": "Fair 3",
      "default": "Affordable Art Fair Battersea Spring"
    },
    {
      "type": "text",
      "id": "loc_3",
      "label": "Location 3",
      "default": "London, UK"
    },
    {
      "type": "text",
      "id": "date_3",
      "label": "Date 3",
      "default": "4-8 Mar 2027"
    },
    {
      "type": "checkbox",
      "id": "next_3",
      "label": "Mark as next",
      "default": false
    },
    {
      "type": "url",
      "id": "url_3",
      "label": "Event link 3"
    }
  ],
  "presets": [
    {
      "name": "Exhibitions strip",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
