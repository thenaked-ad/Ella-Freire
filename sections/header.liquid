{%- liquid
  assign t1 = section.settings.ticker_1
  assign t2 = section.settings.ticker_2
  assign t3 = section.settings.ticker_3

  comment
    The logo height is a setting, so the nav bar (and the --header-h spacer the
    rest of the theme pads against) has to grow with it or a tall logo overlaps
    the page. 70/62px are the original desktop/mobile nav heights.
  endcomment
  assign logo_h = section.settings.logo_height | default: 38
  assign logo_h_m = section.settings.logo_height_mobile | default: 30
  assign nav_h = logo_h | plus: 32 | at_least: 70
  assign nav_h_m = logo_h_m | plus: 26 | at_least: 62
  assign ticker_h = 0
  if t1 != blank or t2 != blank or t3 != blank
    assign ticker_h = 34
  endif
  assign head_h = nav_h | plus: ticker_h
  assign head_h_m = nav_h_m | plus: ticker_h
-%}
<style>
  :root{--header-h:{{ head_h }}px;}
  #site-header .nav{height:{{ nav_h }}px;}
  #site-header .nav__logo img{height:{{ logo_h }}px;width:auto;max-width:100%;}
  @media(max-width:768px){
    :root{--header-h:{{ head_h_m }}px;}
    #site-header .nav{height:{{ nav_h_m }}px;}
    #site-header .nav__logo img{height:{{ logo_h_m }}px;}
  }
</style>
<header class="header" id="site-header">
  {%- if t1 != blank or t2 != blank or t3 != blank -%}
  <div class="ticker" aria-hidden="true"><div class="ticker__track">
    {%- for i in (1..2) -%}
      {%- if t1 != blank -%}<span><i></i>{{ t1 }}</span>{%- endif -%}
      {%- if t2 != blank -%}<span><i></i>{{ t2 }}</span>{%- endif -%}
      {%- if t3 != blank -%}<span><i></i>{{ t3 }}</span>{%- endif -%}
    {%- endfor -%}
  </div></div>
  {%- endif -%}
  <div class="container">
    <nav class="nav" aria-label="Main">
      <a href="{{ routes.root_url }}" class="nav__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_w = logo_h | times: section.settings.logo.aspect_ratio | round | at_least: 1 -%}
          <img src="{{ section.settings.logo | image_url: width: 900 }}" alt="{{ shop.name }}" width="{{ logo_w }}" height="{{ logo_h }}">
        {%- else -%}
          {%- assign logo_w = logo_h | times: 3.385 | round -%}
          <img src="{{ 'logo-rev.png' | asset_url }}" alt="{{ shop.name }}" width="{{ logo_w }}" height="{{ logo_h }}">
        {%- endif -%}
      </a>
      <div class="nav__links">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}" class="nav__link{% if link.active or link.child_active %} is-active{% endif %}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
      <div class="nav__icons">
        <a href="{{ routes.search_url }}" class="nav__icon nav__icon--search" aria-label="Search">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.4 15.4 21 21"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" class="nav__icon nav__icon--cart" data-cart-open aria-label="Cart ({{ cart.item_count }} items)">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7.5 8V6.5a4.5 4.5 0 0 1 9 0V8"/><path d="M4.4 8h15.2l-1.2 12.2a1.5 1.5 0 0 1-1.5 1.35H7.1a1.5 1.5 0 0 1-1.5-1.35L4.4 8Z"/></svg>
          <span class="cart-count" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
        </a>
        <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="drawer-nav"><span></span><span></span><span></span></button>
      </div>
    </nav>
  </div>
  <div class="drawer-nav" id="drawer-nav">
    {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
    <a href="{{ routes.search_url }}">Search</a>
    <div class="drawer-nav__meta">{{ section.settings.drawer_note }}</div>
  </div>
</header>
<div style="height:var(--header-h)" aria-hidden="true" class="header-spacer" hidden></div>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (white on transparent)", "info": "PNG or SVG. Leave empty to use the built-in signature." },
    { "type": "range", "id": "logo_height", "label": "Logo height (desktop)", "min": 20, "max": 90, "step": 2, "unit": "px", "default": 38 },
    { "type": "range", "id": "logo_height_mobile", "label": "Logo height (mobile)", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 30 },
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "header", "content": "Ticker" },
    { "type": "text", "id": "ticker_1", "label": "Ticker item 1", "default": "Exhibiting next · Affordable Art Fair Battersea · 14-18 Oct 2026" },
    { "type": "text", "id": "ticker_2", "label": "Ticker item 2", "default": "Officially licensed Pan Am · TWA · Braniff" },
    { "type": "text", "id": "ticker_3", "label": "Ticker item 3", "default": "Limited editions of 25 · Hand finished in London" },
    { "type": "text", "id": "drawer_note", "label": "Mobile menu footer note", "default": "Delta House Studios, Wimbledon · hello@ellafreire.com" }
  ]
}
{% endschema %}
