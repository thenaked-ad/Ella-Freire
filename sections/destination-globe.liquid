{%- assign coll = collections[section.settings.collection] -%}
{%- if coll == blank or coll.products.size == 0 -%}{%- assign coll = collections.all -%}{%- endif -%}
<section class="globe" id="destinations">
  {% render 'globe-deco', size: 300, opacity: 0.05, style: 'top:-6%;right:-5%' %}
  <div class="globe__intro reveal">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="h2">{{ section.settings.heading }}</h2>
    <p class="lede" style="margin-top:14px">{{ section.settings.text }}</p>
  </div>
  <div class="globe__layout">
  <div class="globe__stage reveal">
    <canvas id="globe-canvas" aria-label="Interactive globe of destinations" role="img"></canvas>
    <div class="globe__loading">Plotting routes…</div>
    <div class="globe__zoom"><button id="zoom-in" aria-label="Zoom in">+</button><button id="zoom-out" aria-label="Zoom out">&minus;</button></div>
    <span class="globe__hint">{{ section.settings.hint }}</span>
    <div class="globe-card" id="globe-card">
      <div class="globe-card__img" id="gc-img"></div>
      <div class="globe-card__body">
        <span class="globe-card__code" id="gc-code"></span>
        <h3 class="globe-card__name" id="gc-name"></h3>
        <span class="globe-card__meta" id="gc-meta"></span>
        <a class="link" id="gc-link" href="#">View this piece →</a>
      </div>
    </div>
  </div>
  <div class="board reveal">
    <div class="board__head"><span class="board__title">{{ section.settings.board_title }}</span><span class="board__live"><i></i>{{ section.settings.board_sub }}</span></div>
    <div class="board__cols"><span>Flight</span><span>Destination</span><span>Status</span><span>Price</span></div>
    <div id="board-rows" data-limit="{{ section.settings.limit }}"></div>
    <div class="board__foot"><a href="{{ coll.url }}" class="link light">All {{ coll.products_count }} destinations →</a></div>
  </div>
  </div>
  <script type="application/json" id="globe-data">[
    {%- for product in coll.products limit: 60 -%}{% render 'product-json', product: product %}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
  ]</script>
</section>
{% schema %}
{
  "name": "Destination globe",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection to plot", "info": "Cities are detected from product titles automatically. Add product metafields custom.latitude / custom.longitude / custom.airport_code to override." },
    { "type": "range", "id": "limit", "label": "Rows on departures board", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Route Map" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where will you travel?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every print marks a destination from the golden age of flight. Spin the globe, zoom in, or choose a city from the departures board." },
    { "type": "text", "id": "hint", "label": "Interaction hint", "default": "Drag to spin · Tap a city · Pinch or ⌘ + scroll to zoom" },
    { "type": "text", "id": "board_title", "label": "Board title", "default": "Departures" },
    { "type": "text", "id": "board_sub", "label": "Board subtitle", "default": "Live · Editions of 25" }
  ]
}
{% endschema %}
