<section class="page-hero">
  {% render 'globe-deco', size: 320, opacity: 0.06, style: 'top:-8%;right:-4%' %}
  <div class="container" style="position:relative"><span class="eyebrow">See it in person</span><h1 class="h1">{{ section.settings.headline | default: page.title }}</h1><p class="lede">{{ section.settings.intro }}</p></div>
</section>
<section class="section">
  <div class="narrow">
    {%- comment -%}
      Exhibitions are blocks, so Ella can add as many as she likes, drag them
      into order, give each one its own event link, and mark the ones that have
      already happened. Upcoming and past are rendered as two separate lists
      from the same block list.
    {%- endcomment -%}
    {%- assign upcoming = section.blocks | where: 'type', 'exhibition' -%}

    {%- assign n_up = 0 -%}
    {%- for block in upcoming -%}{%- unless block.settings.is_past -%}{%- assign n_up = n_up | plus: 1 -%}{%- endunless -%}{%- endfor -%}
    {%- assign n_past = upcoming.size | minus: n_up -%}

    {%- if n_up > 0 -%}
    <span class="eyebrow" style="margin-bottom:24px">{{ section.settings.upcoming_label }}</span>
    <div class="exh-list">
    {%- for block in upcoming -%}
      {%- unless block.settings.is_past -%}
        {%- render 'exhibition-row', block: block -%}
      {%- endunless -%}
    {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if n_past > 0 -%}
    <span class="eyebrow" style="margin-bottom:24px;margin-top:64px;display:block">{{ section.settings.past_label }}</span>
    <div class="exh-list exh-past">
    {%- for block in upcoming -%}
      {%- if block.settings.is_past -%}
        {%- render 'exhibition-row', block: block -%}
      {%- endif -%}
    {%- endfor -%}
    </div>
    {%- endif -%}

    {%- if page.content != blank -%}<div class="rte" style="margin-top:40px">{{ page.content }}</div>{%- endif -%}
  </div>
</section>
<section class="section bg-sec">
  <div class="narrow">
    <span class="eyebrow">Represented by</span>
    <h2 class="h2" style="margin-bottom:36px">{{ section.settings.gal_heading }}</h2>
    <div class="galleries">
      <div class="gallery reveal"><h3>{{ section.settings.gal_1 }}</h3><span>{{ section.settings.gal_1_loc }}</span></div>
      <div class="gallery reveal d1"><h3>{{ section.settings.gal_2 }}</h3><span>{{ section.settings.gal_2_loc }}</span></div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Exhibitions page",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Exhibitions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Ella's large-format prints are best experienced in person. Find the work at one of these fairs, or with the galleries that represent her year-round."
    },
    {
      "type": "text",
      "id": "upcoming_label",
      "label": "Upcoming heading",
      "default": "Upcoming"
    },
    {
      "type": "text",
      "id": "past_label",
      "label": "Past heading",
      "default": "Previously"
    },
    {
      "type": "text",
      "id": "gal_heading",
      "label": "Galleries heading",
      "default": "Find Ella's work year-round"
    },
    {
      "type": "text",
      "id": "gal_1",
      "label": "Gallery 1",
      "default": "Air Contemporary"
    },
    {
      "type": "text",
      "id": "gal_1_loc",
      "label": "Gallery 1 location",
      "default": "London, United Kingdom"
    },
    {
      "type": "text",
      "id": "gal_2",
      "label": "Gallery 2",
      "default": "J. Nunez Galleries"
    },
    {
      "type": "text",
      "id": "gal_2_loc",
      "label": "Gallery 2 location",
      "default": "United States"
    }
  ],
  "blocks": [
    {
      "type": "exhibition",
      "name": "Exhibition",
      "limit": 50,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Fair or exhibition",
          "default": "Affordable Art Fair"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Battersea Park, London, UK"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "14-18 Oct 2026"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "info": "Optional. Stand number, gallery, opening times."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Event link",
          "info": "Optional. Links the row to the fair's own page."
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Event details"
        },
        {
          "type": "checkbox",
          "id": "is_next",
          "label": "Mark as next",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "is_past",
          "label": "This one has already happened",
          "info": "Moves it into the past list.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Exhibitions page",
      "blocks": [
        {
          "type": "exhibition",
          "settings": {
            "name": "Affordable Art Fair | NEW YORK",
            "location": "Starrett-Lehigh Building, New York, USA",
            "date": "16-20 Sep 2026",
            "is_next": true
          }
        },
        {
          "type": "exhibition",
          "settings": {
            "name": "The Other Art Fair | LOS ANGELES",
            "location": "Barker Hangar, Santa Monica, California, USA",
            "date": "26-29 Nov 2026"
          }
        },
        {
          "type": "exhibition",
          "settings": {
            "name": "Affordable Art Fair | BOSTON",
            "location": "Suffolk Downs, Boston, USA",
            "date": "22-26 Oct 2026"
          }
        }
      ]
    }
  ]
}
{% endschema %}
