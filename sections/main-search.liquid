{%- comment -%}
  Search results.

  - Products only (type=product), paginated - previously only the first page of results was
    ever shown, with no way to reach the rest.
  - Shopify's storefront search also returns "semantic" matches: searching Havana brings back
    Miami, Hawaii and so on. Products whose title or tags contain every word searched are
    shown first as the real matches; the rest sit under "Related prints".
{%- endcomment -%}
{%- liquid
  assign q = search.terms | strip
  assign q_words = q | downcase | split: ' '
-%}
<section class="page-basic"><div class="container">
  <span class="eyebrow">Search</span>
  <h1 class="h1" style="margin-bottom:28px">{% if search.performed %}&ldquo;{{ q | escape }}&rdquo;{% else %}{{ section.settings.heading | default: 'Find a destination' }}{% endif %}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input type="hidden" name="type" value="product">
    <input type="search" name="q" value="{{ q | escape }}" placeholder="City, airline, or print" aria-label="Search" required>
    <button class="btn btn--primary">Search</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- capture matches -%}{%- endcapture -%}
      {%- capture related -%}{%- endcapture -%}
      {%- assign n_matches = 0 -%}
      {%- assign n_related = 0 -%}
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {%- assign tag_str = item.tags | join: ' ' -%}
          {%- assign hay = item.title | append: ' ' | append: tag_str | downcase -%}
          {%- assign is_match = true -%}
          {%- for w in q_words -%}
            {%- unless hay contains w -%}{%- assign is_match = false -%}{%- endunless -%}
          {%- endfor -%}
          {%- capture card -%}{% render 'product-card', product: item %}{%- endcapture -%}
          {%- if is_match -%}
            {%- assign matches = matches | append: card -%}{%- assign n_matches = n_matches | plus: 1 -%}
          {%- else -%}
            {%- assign related = related | append: card -%}{%- assign n_related = n_related | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if n_matches > 0 -%}
        <div class="grid">{{ matches }}</div>
      {%- elsif paginate.current_page == 1 -%}
        <p class="lede search-none">No prints match &ldquo;{{ q | escape }}&rdquo; exactly{% if n_related > 0 %} &mdash; here are some related ones{% endif %}.</p>
      {%- endif -%}

      {%- if n_related > 0 -%}
        {%- if n_matches > 0 or paginate.current_page > 1 -%}<h2 class="search-related">{{ section.settings.related_heading | default: 'Related prints' }}</h2>{%- endif -%}
        <div class="grid">{{ related }}</div>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div></section>
{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading before a search", "default": "Find a destination" },
    { "type": "text", "id": "related_heading", "label": "Heading for related results", "default": "Related prints",
      "info": "Shopify's search also suggests related products. Exact matches show first; these follow under this heading." }
  ]
}
{% endschema %}
