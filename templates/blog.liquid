<section class="page-basic"><div class="narrow"><span class="eyebrow">Journal</span><h1 class="h1" style="margin-bottom:36px">{{ blog.title }}</h1>
{%- paginate blog.articles by 12 -%}{%- for article in blog.articles -%}<a href="{{ article.url }}" class="blog-item"><time>{{ article.published_at | date: '%B %e, %Y' }}</time><h2>{{ article.title }}</h2><p class="rte">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p></a>{%- endfor -%}
{% render 'pagination', paginate: paginate %}{%- endpaginate -%}</div></section>
