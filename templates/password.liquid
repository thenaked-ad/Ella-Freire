<section class="error-page"><div class="xnarrow"><img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="677" height="200" style="height:64px;width:auto;margin:0 auto 28px"><span class="eyebrow">Now boarding soon</span><p class="lede">{{ shop.password_message | default: 'A new destination is on its way.' }}</p>
{%- form 'storefront_password' -%}{%- if form.errors -%}<div class="notice notice--err">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="field" style="max-width:360px;margin:24px auto 0"><input type="password" name="password" placeholder="Password" required></div><button class="btn btn--primary">Enter</button>{%- endform -%}</div></section>
