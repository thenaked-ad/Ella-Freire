<section class="page-basic"><div class="auth"><span class="eyebrow">Account</span><h1 class="h2" style="margin-bottom:28px">Reset password</h1>{%- form 'reset_customer_password' -%}{%- if form.errors -%}<div class="notice notice--err">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="field"><label for="p-pass">New password</label><input id="p-pass" type="password" name="customer[password]" required></div><div class="field"><label for="p-pass2">Confirm</label><input id="p-pass2" type="password" name="customer[password_confirmation]" required></div><button class="btn btn--primary btn--full">Save</button>{%- endform -%}</div></section>
