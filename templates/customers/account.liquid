<section class="page-basic"><div class="narrow"><span class="eyebrow">Account</span><h1 class="h2" style="margin-bottom:28px">Hello {{ customer.first_name }}</h1>
{%- if customer.orders.size > 0 -%}{%- for order in customer.orders -%}<div class="list-item"><a href="{{ order.customer_url }}"><b>{{ order.name }}</b></a> · {{ order.created_at | date: '%d %b %Y' }} · {{ order.total_price | money }} · {{ order.fulfillment_status_label }}</div>{%- endfor -%}{%- else -%}<p class="lede">No orders yet.</p>{%- endif -%}
<p style="margin-top:28px"><a href="{{ routes.account_addresses_url }}" class="link">Addresses</a> &nbsp;&nbsp; <a href="{{ routes.account_logout_url }}" class="link">Log out</a></p></div></section>
