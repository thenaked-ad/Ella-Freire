<section class="page-basic"><div class="auth"><span class="eyebrow">Account</span><h1 class="h2" style="margin-bottom:28px">Create account</h1>
{%- form 'create_customer' -%}{%- if form.errors -%}<div class="notice notice--err">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="field"><label for="r-first">First name</label><input id="r-first" type="text" name="customer[first_name]"></div><div class="field"><label for="r-last">Last name</label><input id="r-last" type="text" name="customer[last_name]"></div><div class="field"><label for="r-email">Email</label><input id="r-email" type="email" name="customer[email]" required></div><div class="field"><label for="r-pass">Password</label><input id="r-pass" type="password" name="customer[password]" required></div><button class="btn btn--primary btn--full">Create account</button>{%- endform -%}</div></section>
