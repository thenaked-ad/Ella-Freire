<section class="page-basic"><div class="auth"><span class="eyebrow">Account</span><h1 class="h2" style="margin-bottom:28px">Welcome back</h1>
{%- form 'customer_login' -%}{%- if form.errors -%}<div class="notice notice--err">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="field"><label for="l-email">Email</label><input id="l-email" type="email" name="customer[email]" required></div><div class="field"><label for="l-pass">Password</label><input id="l-pass" type="password" name="customer[password]" required></div><button class="btn btn--primary btn--full">Sign in</button>{%- endform -%}
<p style="margin-top:22px;font-size:13px;color:var(--mid)">New here? <a href="{{ routes.account_register_url }}" class="link">Create account</a></p></div></section>
