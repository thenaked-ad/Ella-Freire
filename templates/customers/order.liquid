<section class="page-basic"><div class="narrow"><span class="eyebrow">Order {{ order.name }}</span><h1 class="h2" style="margin-bottom:28px">{{ order.created_at | date: '%d %B %Y' }}</h1>{%- for line in order.line_items -%}<div class="list-item">{{ line.title }} × {{ line.quantity }} <span style="float:right">{{ line.final_line_price | money }}</span></div>{%- endfor -%}<div class="cart-summary" style="margin-top:20px"><span>Total</span><b>{{ order.total_price | money }}</b></div><p style="margin-top:28px"><a href="{{ routes.account_url }}" class="link">Back to account</a></p></div></section>
