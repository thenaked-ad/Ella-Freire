<section class="page-basic"><div class="auth"><span class="eyebrow">Account</span><h1 class="h2" style="margin-bottom:28px">Activate account</h1>{%- form 'activate_customer_password' -%}{%- if form.errors -%}<div class="notice notice--err">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="field"><label for="a-pass">Password</label><input id="a-pass" type="password" name="customer[password]" required></div><div class="field"><label for="a-pass2">Confirm password</label><input id="a-pass2" type="password" name="customer[password_confirmation]" required></div><button class="btn btn--primary btn--full">Activate</button>{%- endform -%}</div></section>
