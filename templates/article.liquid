<section class="page-basic"><article class="article"><span class="eyebrow">{{ article.published_at | date: '%B %e, %Y' }}</span><h1 class="h1" style="margin-bottom:32px">{{ article.title }}</h1>{%- if article.image -%}<img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | escape }}" width="1400" height="900" style="margin-bottom:32px">{%- endif -%}<div class="rte">{{ article.content }}</div></article></section>
