<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1B3A6B">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/png" href="{% if settings.favicon != blank %}{{ settings.favicon | image_url: width: 64 }}{% else %}{{ 'favicon.png' | asset_url }}{% endif %}">
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}
  {%- comment -%} Cormorant Garamond (SIL Open Font License) is served from the theme rather than
  Google Fonts: no extra connection before the headline can render, and visitors' IP
  addresses aren't sent to Google. Variable files, one per style; the rules
  mirror Google's own declarations weight by weight so the type renders exactly as it did.
  The regular Latin file draws the hero headline, so it's preloaded. {%- endcomment -%}
  {{ 'cormorant-garamond-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  <style>
    @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-italic-latin-ext.woff2' | asset_url }}) format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;}
    @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-italic-latin.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
    @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-italic-latin-ext.woff2' | asset_url }}) format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;}
    @font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-italic-latin.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-latin-ext.woff2' | asset_url }}) format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:400;font-display:swap;src:url({{ 'cormorant-garamond-latin.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-latin-ext.woff2' | asset_url }}) format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:500;font-display:swap;src:url({{ 'cormorant-garamond-latin.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:600;font-display:swap;src:url({{ 'cormorant-garamond-latin-ext.woff2' | asset_url }}) format('woff2');unicode-range:U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;}
    @font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:600;font-display:swap;src:url({{ 'cormorant-garamond-latin.woff2' | asset_url }}) format('woff2');unicode-range:U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;}
    @font-face{font-family:'SI';font-weight:400;font-style:normal;font-display:swap;src:url({{ 'SuisseIntl-Regular.woff' | asset_url }}) format('woff');}
    @font-face{font-family:'SI';font-weight:500;font-style:normal;font-display:swap;src:url({{ 'SuisseIntl-Medium.woff' | asset_url }}) format('woff');}
  </style>
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  <script>window.ELLA={moneyFormat:{{ shop.money_format | json }}};</script>
  {{ content_for_header }}
</head>
<body class="template-{{ template | replace: '.', '-' | handle }}">
  <a class="skip-to-content" href="#main">Skip to content</a>
  {% sections 'header-group' %}
  <main id="main" role="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% render 'cart-drawer' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {%- comment -%} The globe needs ~180KB of script. Collection pages show the route map right
  under the header, so load it straight away there. On the homepage the globe is below the
  fold, so fetch it only as it approaches the screen - or not at all if the section has been
  removed. globe.js initialises itself whenever it arrives. {%- endcomment -%}
  {% if template contains 'collection' %}
  <script src="{{ 'd3-geo.min.js' | asset_url }}" defer></script>
  <script src="{{ 'globe-land.js' | asset_url }}" defer></script>
  <script src="{{ 'globe.js' | asset_url }}" defer></script>
  {% elsif template == 'index' %}
  <script>
  (function () {
    var target = document.getElementById('globe-canvas') || document.getElementById('routemap');
    if (!target) return;
    var srcs = [{{ 'd3-geo.min.js' | asset_url | json }}, {{ 'globe-land.js' | asset_url | json }}, {{ 'globe.js' | asset_url | json }}];
    var started = false;
    function next(i) {
      if (i >= srcs.length) return;
      var s = document.createElement('script'); s.src = srcs[i]; s.onload = function () { next(i + 1); };
      document.body.appendChild(s);
    }
    function start() { if (started) return; started = true; next(0); }
    if (!('IntersectionObserver' in window)) return start();
    var io = new IntersectionObserver(function (es) {
      if (es.some(function (e) { return e.isIntersecting; })) { io.disconnect(); start(); }
    }, { rootMargin: '800px 0px' });
    io.observe(target);
  })();
  </script>
  {% endif %}
</body>
</html>
