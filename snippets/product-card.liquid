{%- liquid
  assign stock = nil
  assign tracked = false
  for v in product.variants
    if v.inventory_management != blank
      assign tracked = true
      assign stock = stock | default: 0 | plus: v.inventory_quantity
    endif
  endfor
  assign kind = product.type | default: ''
  assign lower = product.title | append: ' ' | append: kind | append: ' ' | append: product.tags | join: ' ' | downcase
  assign airline = 'Pan Am'
  if lower contains 'braniff'
    assign airline = 'Braniff'
  elsif lower contains 'twa'
    assign airline = 'TWA'
  elsif lower contains 'bus' or lower contains 'train' or lower contains 'ticket'
    assign airline = 'Bus & Train'
  endif
  assign city = ''
  if product.title contains '‘'
    assign city = product.title | split: '‘' | last | split: '’' | first
  elsif product.title contains "'"
    assign parts = product.title | split: "'"
    if parts.size >= 3
      assign city = parts[1]
    endif
  endif
  if city == ''
    assign city = product.title | replace: 'LUGGAGE TAG', '' | replace: 'Luggage Tag', ''
  endif
  assign words = city | downcase | strip | split: ' '
  assign city = ''
  for w in words
    if w == 'jfk' or w == 'lax' or w == 'sfo' or w == 'nyc' or w == 'ord' or w == 'lgw' or w == 'lhr' or w == 'dfw' or w == 'cdg' or w == 'ams' or w == 'mia' or w == 'bos' or w == 'lon' or w == 'par' or w == 'rom' or w == 'hkg' or w == 'tyo' or w == 'rio' or w == 'syd' or w == 'dub'
      assign cw = w | upcase
    else
      assign cw = w | capitalize
    endif
    assign city = city | append: cw | append: ' '
  endfor
  assign city = city | strip
-%}
<a href="{{ product.url }}" class="tag-card reveal" data-title="{{ product.title | escape }}" data-handle="{{ product.handle }}" data-airline="{{ airline | handleize }}">
  <div class="tag-card__media">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 700 }}" srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 700 }} 700w, {{ product.featured_image | image_url: width: 1000 }} 1000w" sizes="(max-width:768px) 50vw, 25vw" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="700" height="875" loading="lazy">
    {%- else -%}
      <div class="tag-card__mock"><div class="tag"><b>{{ city | truncate: 3, '' | upcase }}</b><small>{{ airline }}</small></div></div>
    {%- endif -%}
    {%- unless product.available -%}<span class="tag-card__badge tag-card__badge--sold">Sold out</span>
    {%- elsif tracked and stock <= 5 -%}<span class="tag-card__badge tag-card__badge--low">Final call · {{ stock }} left</span>
    {%- elsif product.compare_at_price > product.price -%}<span class="tag-card__badge">Offer</span>{%- endunless -%}
  </div>
  <div class="tag-card__body">
    <div>
      <span class="tag-card__code" data-auto>{{ product.metafields.custom.airport_code }}</span>
      <div class="tag-card__title">{{ city }}</div>
      <div class="tag-card__sub">{{ airline }} · Edition of {{ product.metafields.custom.edition_size | default: 25 }}</div>
    </div>
    <div class="tag-card__price">{%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}{{ product.price | money_without_trailing_zeros }}</div>
  </div>
</a>
