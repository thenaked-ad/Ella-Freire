<div class="cart-overlay" id="cart-overlay"></div>
<aside class="cart-drawer" id="cart-drawer" aria-label="Cart" aria-hidden="true">
  <div class="cart-drawer__head"><h2>Your Cart</h2><button class="cart-drawer__close" data-cart-close aria-label="Close">&times;</button></div>
  <div class="cart-drawer__body" id="cart-drawer-body"><div class="cart-empty">Loading…</div></div>
  <div class="cart-drawer__foot" id="cart-drawer-foot">
    <div class="cart-total"><span>Subtotal</span><b id="cart-total">{{ cart.total_price | money }}</b></div>
    <p class="cart-note">Shipping calculated at checkout. Each piece is made to order, 3 to 4 weeks.</p>
    <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary btn--full" style="margin-bottom:8px">Checkout</a>
    <a href="{{ routes.cart_url }}" class="btn btn--outline btn--full">View cart</a>
  </div>
</aside>
